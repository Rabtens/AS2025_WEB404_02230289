<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>DemoBank — Account (SECURE)</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 560px; margin: 3rem auto; padding: 0 1rem; }
    .banner { background:#bbf7d0; border:1px solid #16a34a; padding:.5rem .75rem; border-radius:6px; font-size:.9rem; }
    .card { border:1px solid #ddd; border-radius:8px; padding:1rem 1.25rem; margin:1rem 0; }
    .current { font-size:1.1rem; }
    code { background:#f3f4f6; padding:.1rem .3rem; border-radius:4px; }
    label { display:block; margin:.75rem 0 .25rem; }
    input { width:100%; padding:.5rem; box-sizing:border-box; }
    button { margin-top:1rem; padding:.5rem 1rem; }
  </style>
</head>
<body>
  <p class="banner">🔒 SECURE build — the form below carries a hidden <code>_csrf</code> token.</p>
  <h1>Welcome, <%= user.username %></h1>

  <div class="card">
    <p class="current">Current email on file:
      <strong id="current-email"><%= user.email %></strong>
    </p>
  </div>

  <div class="card">
    <h2>Change email</h2>
    <form method="POST" action="/account/change-email">
      <!-- FIX: synchronizer token — verified server-side on POST. -->
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="email">New email</label>
      <input id="email" name="email" type="email" value="<%= user.email %>">
      <button type="submit">Update email</button>
    </form>
  </div>

  <form method="POST" action="/logout">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit">Log out</button>
  </form>
</body>
</html>
